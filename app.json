{
  "expo": {
    "name": "EEGo",
    "slug": "EEGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appIcon02.png",
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/appIcon02.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Appen bruger bluetooth til at finde og kommunikere med EEG-enheder.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "bundleIdentifier": "com.stigafp.EEGo"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/appIcon02.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/appIcon02.png"
    },
    "extra": {
      "eas": {
        "projectId": "dd899c98-26c4-4cb2-a447-76ddb2594e4b"
      }
    }
  }
}
